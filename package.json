{
  "name": "highlight-code-snippet",
  "displayName": "Highlight Code Snippet",
  "description": "Highlight selected code snippets with a color and adjustable transparency",
  "version": "0.2.2",
  "icon": "icon.png",
  "publisher": "Traveler",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rovie569/Highlight-Code-Snippets.git"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "highlight-code-snippet.highlight",
        "title": "Highlight Selection"
      },
      {
        "command": "highlight-code-snippet.pickColor",
        "title": "Pick Highlight Color"
      },
      {
        "command": "highlight-code-snippet.clearSpecific",
        "title": "Clear Specific Highlight"
      },
      {
        "command": "highlight-code-snippet.clear",
        "title": "Clear All Highlights"
      }
    ],
    "keybindings": [
      {
        "command": "highlight-code-snippet.highlight",
        "key": "ctrl+h ctrl+i",
        "when": "editorTextFocus"
      },
      {
        "command": "highlight-code-snippet.pickColor",
        "key": "ctrl+alt+h",
        "when": "editorTextFocus"
      },
      {
        "command": "highlight-code-snippet.clearSpecific",
        "key": "ctrl+shift+alt+h",
        "when": "editorTextFocus"
      },
      {
        "command": "highlight-code-snippet.clear",
        "key": "ctrl+shift+h",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "highlight-code-snippet.highlight",
          "when": "editorHasSelection",
          "group": "navigation"
        },
        {
          "command": "highlight-code-snippet.pickColor",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "highlight-code-snippet.clearSpecific",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "highlight-code-snippet.clear",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Highlight Code Snippet",
      "properties": {
        "highlightCodeSnippet.defaultColor": {
          "type": "string",
          "default": "rgba(255,255,0,0.3)",
          "description": "Default highlight color with adjustable transparency"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "22.x",
    "typescript": "^5.9.3",
    "eslint": "^9.39.1"
  }
}